<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="itemDetailDialog"
        title="{dialogModel>/title}"
        contentWidth="85%"
        contentHeight="70%"
        resizable="true"
        draggable="true">
        <content>
            <Table
                id="dialogItemTable"
                inset="false"
                items="{dialogModel>/items}">
                <columns>
                    <Column width="60px"><Text text="{i18n>colOrderId}"/></Column>
                    <Column width="130px"><Text text="{i18n>colDurum}"/></Column>
                    <Column width="130px" hAlign="End"><Text text="{i18n>colTutar}"/></Column>
                    <Column width="160px"><Text text="{i18n>colMasrafTipi}"/></Column>
                    <Column width="100px"><Text text="{i18n>colMasrafYeri}"/></Column>
                    <Column width="120px"><Text text="{i18n>colPYPKodu}"/></Column>
                    <Column width="70px" hAlign="End"><Text text="{i18n>colKdvOrani}"/></Column>
                    <Column width="80px"><Text text="{i18n>colZcheck}"/></Column>
                    <Column width="150px"><Text text="{i18n>colFaturaId}"/></Column>
                    <Column width="120px"><Text text="{i18n>colEfaturaCari}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colAciklama}"/></Column>
                    <Column width="130px"><Text text="{i18n>colVirmanBelge}"/></Column>
                    <Column width="130px"><Text text="{i18n>colGiderBelge}"/></Column>
                    <Column width="130px"><Text text="{i18n>colTersBelge}"/></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{dialogModel>OrderId}"/>
                            <ObjectStatus
                                text="{path: 'dialogModel>KalemDurum', formatter: '.formatter.formatKalemStatusText'}"
                                state="{path: 'dialogModel>KalemDurum', formatter: '.formatter.formatKalemStatusState'}"
                                icon="{path: 'dialogModel>KalemDurum', formatter: '.formatter.formatKalemStatusIcon'}"/>
                            <ObjectNumber
                                number="{path: 'dialogModel>Tutar', formatter: '.formatter.formatCurrencyAmount'}"
                                unit="{dialogModel>ParaBirimi}"/>
                            <Text text="{= ${dialogModel>MasrafTipiTanim} ? ${dialogModel>MasrafTipiTanim} : ${dialogModel>MasrafTipi}}"/>
                            <Text text="{dialogModel>MasrafYeri}"/>
                            <Text text="{dialogModel>PYPKodu}"/>
                            <Text text="{dialogModel>KdvOrani}"/>
                            <Text text="{dialogModel>Zcheck}"/>
                            <Text text="{dialogModel>FaturaId}"/>
                            <Text text="{dialogModel>EfaturaCari}"/>
                            <Text text="{dialogModel>Aciklama}"/>
                            <Text text="{= ${dialogModel>VirmanBelge} ? ${dialogModel>VirmanBelge} + (${dialogModel>VirmanYil} ? ' / ' + ${dialogModel>VirmanYil} : '') : ''}"/>
                            <Text text="{= ${dialogModel>GiderBelge} ? ${dialogModel>GiderBelge} + (${dialogModel>GiderYil} ? ' / ' + ${dialogModel>GiderYil} : '') : ''}"/>
                            <Text text="{= ${dialogModel>TersBelge} ? ${dialogModel>TersBelge} + (${dialogModel>TersYil} ? ' / ' + ${dialogModel>TersYil} : '') : ''}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button text="{i18n>btnClose}" type="Emphasized" press="onCloseItemDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
