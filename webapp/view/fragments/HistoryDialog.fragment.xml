<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="historyDialog"
        title="{historyModel>/title}"
        contentWidth="75%"
        contentHeight="60%"
        resizable="true"
        draggable="true">
        <content>
            <Table
                id="dialogHistoryTable"
                inset="false"
                items="{historyModel>/items}">
                <columns>
                    <Column width="60px"><Text text="{i18n>colSira}"/></Column>
                    <Column width="110px"><Text text="{i18n>colIslem}"/></Column>
                    <Column width="90px"><Text text="{i18n>colSonuc}"/></Column>
                    <Column width="120px"><Text text="{i18n>colBelnr}"/></Column>
                    <Column width="70px"><Text text="{i18n>colGjahr}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colMesaj}"/></Column>
                    <Column width="110px"><Text text="{i18n>colUsnam}"/></Column>
                    <Column width="100px"><Text text="{i18n>colDatum}"/></Column>
                    <Column width="90px"><Text text="{i18n>colUzeit}"/></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{historyModel>Sira}"/>
                            <Text text="{historyModel>Islem}"/>
                            <ObjectStatus
                                text="{= ${historyModel>Sonuc} === 'S' ? 'Başarılı' : 'Hatalı'}"
                                state="{= ${historyModel>Sonuc} === 'S' ? 'Success' : 'Error'}"
                                icon="{= ${historyModel>Sonuc} === 'S' ? 'sap-icon://accept' : 'sap-icon://error'}"/>
                            <Text text="{historyModel>Belnr}"/>
                            <Text text="{historyModel>Gjahr}"/>
                            <Text text="{historyModel>Mesaj}"/>
                            <Text text="{historyModel>Usnam}"/>
                            <Text text="{path: 'historyModel>Datum', formatter: '.formatter.formatDate'}"/>
                            <Text text="{path: 'historyModel>Uzeit', formatter: '.formatter.formatTime'}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button text="{i18n>btnClose}" type="Emphasized" press="onCloseHistoryDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
