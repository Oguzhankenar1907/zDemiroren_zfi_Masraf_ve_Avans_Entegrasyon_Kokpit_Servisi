<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="reversalDialog"
        title="{i18n>dlgTersKayitTitle}"
        contentWidth="400px"
        resizable="false">
        <content>
            <VBox class="sapUiSmallMargin">
                <Text text="{i18n>dlgTersKayitDesc}" class="sapUiSmallMarginBottom" />
                <Label text="{i18n>colKayitTarihi}" />
                <DatePicker
                    id="dpReversalDate"
                    displayFormat="dd.MM.yyyy"
                    valueFormat="yyyy-MM-dd"
                    placeholder="GG.AA.YYYY" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>btnOnayla}" type="Emphasized" press="onConfirmReversal" />
        </beginButton>
        <endButton>
            <Button text="{i18n>btnIptal}" press="onCancelReversal" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
