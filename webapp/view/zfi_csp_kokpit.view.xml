<?xml version="1.0" ?>
<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout" controllerName="com.golive.demiroren.zficspkokpit.controller.zfi_csp_kokpit" displayBlock="true">
    <Page id="page" showHeader="false">
        <content>
            <VBox width="100%">
                <MessageStrip text="{ui&gt;/connection}" showIcon="true"/>
                <MessageStrip text="Avans Talebi Oluştur, SOAP entegrasyonu tamamlanana kadar devre dışıdır." type="Warning" showIcon="true"/>
                <Panel headerText="Filtreler" expandable="true" expanded="true" backgroundDesign="Solid">
                    <layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="2" vSpacing="1">
                        <VBox>
                            <Label text="Şirket Kodu" required="true" labelFor="company" class="sapUiTinyMarginBottom"/>
                            <Input id="company" submit="onSearch" maxLength="4" width="100%" placeholder="Şirket kodu girin"/>
                        </VBox>
                        <VBox>
                            <Label text="TCKN" labelFor="person" class="sapUiTinyMarginBottom"/>
                            <Input id="person" submit="onSearch" maxLength="11" width="100%" placeholder="11 haneli TCKN"/>
                        </VBox>
                        <VBox>
                            <Label text="Belge tarihi aralığı" labelFor="dates" class="sapUiTinyMarginBottom"/>
                            <DateRangeSelection id="dates" displayFormat="dd.MM.yyyy" width="100%"/>
                        </VBox>
                        <VBox>
                            <Label text="Yurtiçi / Yurtdışı" labelFor="area" class="sapUiTinyMarginBottom"/>
                            <Select id="area" width="100%">
                                <core:Item key="" text="Tümü"/>
                                <core:Item key="0" text="Yurtiçi"/>
                                <core:Item key="1" text="Yurtdışı"/>
                                <core:Item key="2" text="Seyahat dışı"/>
                            </Select>
                        </VBox>
                        <VBox>
                            <Label text="Akış numarası" labelFor="flow" class="sapUiTinyMarginBottom"/>
                            <Input id="flow" submit="onSearch" maxLength="19" width="100%" placeholder="Akış numarası girin"/>
                        </VBox>
                        <VBox>
                            <Label text="Form numarası" labelFor="form" class="sapUiTinyMarginBottom"/>
                            <Input id="form" submit="onSearch" maxLength="19" width="100%" placeholder="Form numarası girin"/>
                        </VBox>
                        <VBox>
                            <Label text="Durum (boş seçim: tümü)" labelFor="statuses" class="sapUiTinyMarginBottom"/>
                            <MultiComboBox id="statuses" selectedKeys="B,H" width="100%" placeholder="Tüm durumlar">
                                <core:Item key="B" text="Bekliyor"/>
                                <core:Item key="H" text="Hatalı"/>
                                <core:Item key="M" text="Muhasebeleşti"/>
                                <core:Item key="O" text="Ödendi"/>
                                <core:Item key="V" text="Virman yapıldı"/>
                                <core:Item key="G" text="Giderleştirildi"/>
                                <core:Item key="T" text="Ters kaydedildi"/>
                                <core:Item key="S" text="Silme işaretli"/>
                            </MultiComboBox>
                        </VBox>
                        <VBox>
                            <Label text="&#160;" class="sapUiTinyMarginBottom"/>
                            <CheckBox id="deleted" text="Silme işaretlileri getir"/>
                        </VBox>
                    </layout:Grid>
                    <OverflowToolbar design="Transparent">
                        <ToolbarSpacer/>
                        <Button text="Temizle" icon="sap-icon://clear-filter" type="Transparent" press="onReset"/>
                        <Button text="Filtrele" icon="sap-icon://filter" type="Emphasized" press="onSearch"/>
                    </OverflowToolbar>
                </Panel>
                <OverflowToolbar class="sapUiTinyMarginTop">
                    <Title text="Kayıtlar" level="H3"/>
                    <ToolbarSpacer/>
                    <Button text="Yenile" press="onRefresh" icon="sap-icon://refresh"/>
                    <Button text="Excel'e Aktar" press="onExport" icon="sap-icon://excel-attachment" tooltip="Yalnızca yüklenen satırları Excel’e aktar"/>
                </OverflowToolbar>
                <IconTabBar id="tabs" select="onTabSelect">
                    <items>
                        <IconTabFilter key="A" text="Avans">
                            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true">
                                <Table id="tableA" fixedLayout="false" mode="MultiSelect" selectionChange="onAvansSelectionChange" updateFinished="onAvansSelectionChange" growing="true" growingThreshold="50" itemPress="onDetail" noDataText="Şirket seçip filtreleyin. Sonuç yoksa filtreleri kontrol edin.">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Button text="Avans Talebi Oluştur" enabled="{= ${ui&gt;/advanceBackendReady} &amp;&amp; ${ui&gt;/advanceSelectionEligible} }" tooltip="Backend avans aksiyonu doğrulandıktan ve arayüz çağrısı bağlandıktan sonra kullanıma açılacak; B/H durumunda uygun bir avans seçilmelidir"/>
                                            <Button text="Ters Kayıt" icon="sap-icon://undo" press="onTersKayit" enabled="{ui&gt;/act/A/TersKayit}" tooltip="Seçili formların belgesini ters kaydeder (durum Muhasebeleşti olmalı)"/>
                                            <Button text="Silme İşareti Koy" icon="sap-icon://delete" press="onSilmeKoy" enabled="{ui&gt;/act/A/SilmeKoy}" tooltip="Seçili kayıtlara silme işareti koyar (durum B veya H olmalı)"/>
                                            <Button text="Silmeyi Kaldır" icon="sap-icon://undo" press="onSilmeKaldir" enabled="{ui&gt;/act/A/SilmeKaldir}" tooltip="Silme işaretini kaldırır, kayıt önceki durumuna döner (durum S olmalı)"/>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column>
                                            <Text text="Şirket"/>
                                        </Column>
                                        <Column>
                                            <Text text="Akış"/>
                                        </Column>
                                        <Column>
                                            <Text text="Form"/>
                                        </Column>
                                        <Column>
                                            <Text text="Durum"/>
                                        </Column>
                                        <Column>
                                            <Text text="Masraf Türü"/>
                                        </Column>
                                        <Column>
                                            <Text text="Belge Tarihi"/>
                                        </Column>
                                        <Column>
                                            <Text text="TCKN"/>
                                        </Column>
                                        <Column>
                                            <Text text="Sicil"/>
                                        </Column>
                                        <Column>
                                            <Text text="Mesaj"/>
                                        </Column>
                                        <Column>
                                            <Text text="Süreç Tipi"/>
                                        </Column>
                                        <Column>
                                            <Text text="Yurtiçi/Yurtdışı"/>
                                        </Column>
                                        <Column>
                                            <Text text="Avans Form Numarası"/>
                                        </Column>
                                    </columns>
                                    <dependents>
                                        <ColumnListItem id="rowA" type="Navigation">
                                            <cells>
                                                <Text text="{SirketKodu}"/>
                                                <Text text="{path:'AkisNumarasi', targetType:'any'}" wrapping="false"/>
                                                <Text text="{path:'FormNumarasi', targetType:'any'}" wrapping="false"/>
                                                <ObjectStatus text="{path:'Durum', formatter:'.formatter.status'}" state="{path:'DurumCriticality', formatter:'.formatter.state'}"/>
                                                <Text text="{path:'MasrafTuru', formatter:'.formatter.kind'}"/>
                                                <Text text="{BelgeTarihi}"/>
                                                <Text text="{Tckn}"/>
                                                <Text text="{SicilNo}"/>
                                                <Text text="{HataMesaji}"/>
                                                <Text text="{path:'SurecTipi', formatter:'.formatter.process'}"/>
                                                <Text text="{path:'YurticiYurtdisi', formatter:'.formatter.area'}"/>
                                                <Text text="{path:'AvansFormNumarasi', targetType:'any'}" wrapping="false"/>
                                            </cells>
                                        </ColumnListItem>
                                    </dependents>
                                </Table>
                            </ScrollContainer>
                        </IconTabFilter>
                        <IconTabFilter key="M" text="Masraf">
                            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true">
                                <Table id="tableM" fixedLayout="false" mode="MultiSelect" selectionChange="onRowSelectionChange" updateFinished="onRowSelectionChange" growing="true" growingThreshold="50" itemPress="onDetail" noDataText="Şirket seçip filtreleyin. Sonuç yoksa filtreleri kontrol edin.">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Button text="Muhasebeleştir" icon="sap-icon://accounting-document-verification" type="Emphasized" press="onMuhasebelestir" enabled="{ui&gt;/act/M/Muhasebelestir}" tooltip="Seçili masraf formları için muhasebe belgesi oluşturur (durum B veya H olmalı)"/>
                                            <Button text="Ters Kayıt" icon="sap-icon://undo" press="onTersKayit" enabled="{ui&gt;/act/M/TersKayit}" tooltip="Seçili formların belgesini ters kaydeder (durum Muhasebeleşti olmalı)"/>
                                            <Button text="Silme İşareti Koy" icon="sap-icon://delete" press="onSilmeKoy" enabled="{ui&gt;/act/M/SilmeKoy}" tooltip="Seçili kayıtlara silme işareti koyar (durum B veya H olmalı)"/>
                                            <Button text="Silmeyi Kaldır" icon="sap-icon://undo" press="onSilmeKaldir" enabled="{ui&gt;/act/M/SilmeKaldir}" tooltip="Silme işaretini kaldırır, kayıt önceki durumuna döner (durum S olmalı)"/>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column>
                                            <Text text="Şirket"/>
                                        </Column>
                                        <Column>
                                            <Text text="Akış"/>
                                        </Column>
                                        <Column>
                                            <Text text="Form"/>
                                        </Column>
                                        <Column>
                                            <Text text="Durum"/>
                                        </Column>
                                        <Column>
                                            <Text text="Masraf Türü"/>
                                        </Column>
                                        <Column>
                                            <Text text="Belge Tarihi"/>
