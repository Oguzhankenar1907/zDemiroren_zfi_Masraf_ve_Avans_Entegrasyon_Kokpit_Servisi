                                            <Text text="Muhasebe Belgesi"/>
                                        </Column>
                                        <Column>
                                            <Text text="Ters Kayıt Belgesi"/>
                                        </Column>
                                    </columns>
                                    <dependents>
                                        <ColumnListItem id="rowM" type="Navigation">
                                            <cells>
                                                <Text text="{SirketKodu}"/>
                                                <Text text="{path:'AkisNumarasi', targetType:'any'}" wrapping="false"/>
                                                <Text text="{path:'FormNumarasi', targetType:'any'}" wrapping="false"/>
                                                <ObjectStatus text="{path:'Durum', formatter:'.formatter.status'}" state="{path:'DurumCriticality', formatter:'.formatter.state'}"/>
                                                <Text text="{path:'MasrafTuru', formatter:'.formatter.kind'}"/>
                                                <Text text="{BelgeTarihi}"/>
                                                <Text text="{Tckn}"/>
                                                <Text text="{SicilNo}"/>
                                                <Text text="{HataMesaji}"/>
                                                <Text text="{path:'SurecTipi', formatter:'.formatter.process'}"/>
                                                <Text text="{path:'YurticiYurtdisi', formatter:'.formatter.area'}"/>
                                                <Text text="{path:'AvansFormNumarasi', targetType:'any'}" wrapping="false"/>
                                                <Text text="{parts:[{path:'MuhasebeBelge'},{path:'MuhasebeYil'}], formatter:'.formatter.doc'}" wrapping="false"/>
                                                <Text text="{parts:[{path:'TersBelge'},{path:'TersYil'}], formatter:'.formatter.doc'}" wrapping="false"/>
                                            </cells>
                                        </ColumnListItem>
                                    </dependents>
                                </Table>
                            </ScrollContainer>
                        </IconTabFilter>
                        <IconTabFilter key="E" text="E-Fatura Masrafları">
                            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true">
                                <Table id="tableE" fixedLayout="false" mode="MultiSelect" selectionChange="onRowSelectionChange" updateFinished="onRowSelectionChange" growing="true" growingThreshold="50" itemPress="onDetail" noDataText="Şirket seçip filtreleyin. Sonuç yoksa filtreleri kontrol edin.">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Button text="Virman Yap" icon="sap-icon://journey-change" type="Emphasized" press="onVirman" enabled="{ui&gt;/act/E/Virman}" tooltip="Seçili faturalar için virman belgesi oluşturur (durum B veya H olmalı)"/>
                                            <Button text="Giderleştir" icon="sap-icon://expense-report" press="onGiderlestir" enabled="{ui&gt;/act/E/Giderlestir}" tooltip="Virmanı yapılmış faturalar için giderleştirme belgesi oluşturur (durum V olmalı)"/>
                                            <Button text="Ters Kayıt" icon="sap-icon://undo" press="onTersKayit" enabled="{ui&gt;/act/E/TersKayit}" tooltip="Seçili faturaların giderleştirme (G) veya virman (V) belgesini ters kaydeder"/>
                                            <Button text="Silme İşareti Koy" icon="sap-icon://delete" press="onSilmeKoy" enabled="{ui&gt;/act/E/SilmeKoy}" tooltip="Seçili kayıtlara silme işareti koyar (durum B veya H olmalı)"/>
                                            <Button text="Silmeyi Kaldır" icon="sap-icon://undo" press="onSilmeKaldir" enabled="{ui&gt;/act/E/SilmeKaldir}" tooltip="Silme işaretini kaldırır, kayıt önceki durumuna döner (durum S olmalı)"/>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column>
                                            <Text text="Şirket"/>
                                        </Column>
                                        <Column>
                                            <Text text="Akış"/>
                                        </Column>
                                        <Column>
                                            <Text text="Form"/>
                                        </Column>
