                                        </Column>
                                        <Column>
                                            <Text text="Gider Belgesi"/>
                                        </Column>
                                        <Column>
                                            <Text text="Gider Yılı"/>
                                        </Column>
                                    </columns>
                                    <dependents>
                                        <ColumnListItem id="rowE" type="Navigation">
                                            <cells>
                                                <Text text="{_Header/SirketKodu}"/>
                                                <Text text="{path:'AkisNumarasi', targetType:'any'}" wrapping="false"/>
                                                <Text text="{path:'_Header/FormNumarasi', targetType:'any'}" wrapping="false"/>
                                                <Text text="{FaturaId}"/>
                                                <Text text="{OrderId}"/>
                                                <ObjectStatus text="{parts:[{path:'Zcheck'},{path:'KalemDurum'},{path:'_Header/Durum'}], formatter:'.formatter.itemStatus'}" state="{parts:[{path:'Zcheck'},{path:'KalemDurumCriticality'},{path:'_Header/DurumCriticality'}], formatter:'.formatter.itemState'}"/>
                                                <Text text="{Tutar}"/>
                                                <Text text="{ParaBirimi}"/>
                                                <Text text="{MasrafTipiTanim}"/>
                                                <Text text="{MasrafYeri}"/>
                                                <Text text="{Aciklama}"/>
                                                <Text text="{parts:[{path:'Zcheck'},{path:'HataMesaji'},{path:'_Header/HataMesaji'}], formatter:'.formatter.itemValue'}"/>
                                                <Text text="{path:'_Header/MasrafTuru', formatter:'.formatter.kind'}"/>
                                                <Text text="{path:'_Header/SurecTipi', formatter:'.formatter.process'}"/>
                                                <Text text="{path:'_Header/YurticiYurtdisi', formatter:'.formatter.area'}"/>
                                                <Text text="{path:'_Header/AvansFormNumarasi', targetType:'any'}" wrapping="false"/>
                                                <Text text="{MasrafTipi}"/>
                                                <Text text="{PYPKodu}"/>
                                                <Text text="{KdvOrani}"/>
                                                <Text text="{EfaturaCari}"/>
                                                <Text text="{VirmanBelge}"/>
                                                <Text text="{VirmanYil}"/>
                                                <Text text="{GiderBelge}"/>
                                                <Text text="{GiderYil}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </dependents>
                                </Table>
                            </ScrollContainer>
                        </IconTabFilter>
                        <IconTabFilter key="R" text="Raporlama">
                            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true">
                                <Table id="tableR" fixedLayout="false" growing="true" growingThreshold="50" itemPress="onDetail" noDataText="Şirket seçip filtreleyin. Sonuç yoksa filtreleri kontrol edin.">
